# Copy to .env (gitignored) and fill in. Never commit real values.
PORT=3000

# CRS sandbox (from the CRS booth). Log in once and reuse the token.
CRS_USERNAME=
CRS_PASSWORD=
# Tradelines load from server/scripts/out/ when saved there. true = force one live pull.
CRS_REFRESH_TRADELINES=false

# Cartesia
CARTESIA_API_KEY=

# Gemini (LLM_PROVIDER=gemini) or Claude fallback (LLM_PROVIDER=claude)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Hard cap on Gemini requests per phone call (B4). Past it, analyzeTurn throws GeminiCapError.
GEMINI_MAX_CALLS_PER_CALL=8
ANTHROPIC_API_KEY=

# Scoring (B6). Velocity = distinct InterHoot users one number called within the window.
VELOCITY_WINDOW_HOURS=24
VELOCITY_MIN_USERS=3
# Team decision: let the prototype phrase rules count toward the score (default: reasons only)
PHRASE_RULES_IN_SCORE=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URLs of the telephony server (scam-protection/), used to check Twilio's signatures
TWILIO_WEBHOOK_URL=https://YOUR-TUNNEL/twilio/voice
TWILIO_MEDIA_URL=wss://YOUR-TUNNEL/media
# Where green calls are forwarded if the app's onboarding hasn't saved a phone yet
PROTECTED_PHONE_NUMBER=

# Brain service (server/), called by the telephony server on localhost
BRAIN_PORT=3001
PROTECTED_USER_ID=P20

# APNs (token-based auth). Create the key at developer.apple.com > Certificates, Identifiers & Profiles > Keys.
# Keep the downloaded .p8 file outside the repo and put its full path below.
APNS_KEY_ID=
APNS_TEAM_ID=367GQ32DX6
APNS_KEY_PATH=
APNS_TOPIC=com.aslavny.interhoot
# sandbox for builds run from Xcode, production for TestFlight or the App Store
APNS_ENV=sandbox

# SpacetimeDB (Maincloud)
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=interhoot

DEMO_SCAMMER_PHONE=
DEMO_DENTIST_PHONE=
