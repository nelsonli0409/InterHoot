# Copy to .env (gitignored) and fill in. Never commit real values.
PORT=3000

# CRS sandbox (from the CRS booth). Log in once and reuse the token.
CRS_USERNAME=
CRS_PASSWORD=

# Cartesia
CARTESIA_API_KEY=

# Gemini (LLM_PROVIDER=gemini) or Claude fallback (LLM_PROVIDER=claude)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# APNs (token-based auth). Create the key at developer.apple.com > Certificates, Identifiers & Profiles > Keys.
# Keep the downloaded .p8 file outside the repo and put its full path below.
APNS_KEY_ID=
APNS_TEAM_ID=367GQ32DX6
APNS_KEY_PATH=
APNS_TOPIC=com.aslavny.interhoot
# sandbox for builds run from Xcode, production for TestFlight or the App Store
APNS_ENV=sandbox

# SpacetimeDB (Maincloud)
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=interhoot
