# Copy to .env (gitignored) and fill in. Never commit real values.
PORT=3000

# CRS sandbox (from the CRS booth). Log in once and reuse the token.
CRS_USERNAME=
CRS_PASSWORD=

# Cartesia
CARTESIA_API_KEY=

# Gemini (LLM_PROVIDER=gemini) or Claude fallback (LLM_PROVIDER=claude)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SpacetimeDB (Maincloud)
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=interhoot
